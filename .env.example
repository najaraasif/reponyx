REPONYX_APP_NAME=Reponyx
REPONYX_ENVIRONMENT=development
REPONYX_LOG_LEVEL=INFO
REPONYX_DATABASE_URL=postgresql+psycopg://reponyx:reponyx@localhost:5432/reponyx
REPONYX_OPENAI_API_KEY=
REPONYX_OLLAMA_BASE_URL=http://localhost:11434
REPONYX_WORKSPACE_ROOT=./workspaces
REPONYX_MAX_REPOSITORY_BYTES=100000000
REPONYX_MAX_FILE_BYTES=1000000
REPONYX_MAX_FILES=10000
REPONYX_EMBEDDING_PROVIDER=deterministic
REPONYX_EMBEDDING_MODEL=hash-embedding-v1
REPONYX_EMBEDDING_DIMENSIONS=64
REPONYX_EMBEDDING_BATCH_SIZE=32
REPONYX_EMBEDDING_TIMEOUT_SECONDS=30
REPONYX_SEMANTIC_WEIGHT=0.65
REPONYX_LEXICAL_WEIGHT=0.35
REPONYX_RETRIEVAL_CHARACTER_BUDGET=20000
REPONYX_EXECUTION_IMAGE=reponyx-executor:phase4
REPONYX_EXECUTION_DEFAULT_TIMEOUT_SECONDS=120
REPONYX_EXECUTION_MAX_TIMEOUT_SECONDS=600
REPONYX_EXECUTION_MEMORY_LIMIT=512m
REPONYX_EXECUTION_CPU_LIMIT=1.0
REPONYX_EXECUTION_PIDS_LIMIT=128
REPONYX_EXECUTION_OUTPUT_LIMIT=200000
REPONYX_EXECUTION_NETWORK_DISABLED=true
REPONYX_EXECUTION_ROOT=./executions
REPONYX_REPAIR_WORKSPACE_ROOT=./repair-workspaces
REPONYX_REPAIR_MAX_ITERATIONS=5
REPONYX_LLM_PROVIDER=mock
REPONYX_LLM_MODEL=gpt-4.1-mini
REPONYX_LLM_TIMEOUT_SECONDS=60
REPONYX_LLM_MAX_OUTPUT_TOKENS=4000
REPONYX_LLM_MAX_CALLS=20
REPONYX_LLM_MAX_CONTEXT_CHARACTERS=30000
REPONYX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
